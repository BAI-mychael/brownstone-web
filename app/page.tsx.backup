"use client";

import { FormEvent, useState } from "react";
import { submitLead } from "./actions/leads";
//import EnterpriseServicesModule from '../components/EnterpriseServicesModule';

interface Message {
  role: "user" | "assistant";
  content: string;
}

export default function Home() {
  const [chatInput, setChatInput] = useState("");
  const [messages, setMessages] = useState<Message[]>([
    {
      role: "assistant",
      content:
        "Connection established. How can I assist with your infrastructure today?",
    },
  ]);
  const [isTyping, setIsTyping] = useState(false);
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [submitStatus, setSubmitStatus] = useState<"success" | "error" | null>(
    null,
  );

  const handleChat = (e: FormEvent<HTMLFormElement>) => {
    e.preventDefault();
    if (!chatInput) return;
    const newMessages = [
      ...messages,
      { role: "user" as const, content: chatInput },
    ];
    setMessages(newMessages);
    setChatInput("");
    setIsTyping(true);
    setTimeout(() => {
      setMessages((prev) => [
        ...prev,
        {
          role: "assistant",
          content: "Request received. Analyzing VPC security parameters...",
        },
      ]);
      setIsTyping(false);
    }, 1000);
  };

  const handleAuditRequest = async (e: FormEvent<HTMLFormElement>) => {
    e.preventDefault();
    setIsSubmitting(true);
    setSubmitStatus(null);
    const formData = new FormData(e.currentTarget);
    const emailInput = formData.get("auditEmail") as string;
    const nameInput = formData.get("auditName") as string;
    const serviceInput = formData.get("serviceInterest") as string;
    const dateInput = formData.get("auditDate") as string;
    const timeInput = formData.get("auditTime") as string;
    const messageInput = formData.get("auditMessage") as string;
    let finalMessage = "";
    if (dateInput || timeInput) {
      finalMessage += `Requested Strategy Call: ${dateInput || "Any Day"} at ${timeInput || "Any Time"}\n\n`;
    }
    if (messageInput) {
      finalMessage += `Message:\n${messageInput}`;
    }
    const serverData = new FormData();
    serverData.append("email", emailInput);
    serverData.append("full_name", nameInput || "");
    serverData.append("service_interest", serviceInput || "audit");
    serverData.append("source", "homepage_audit");
    serverData.append(
      "message",
      finalMessage.trim() || "No additional message provided.",
    );
    if (formData.get("fax_number"))
      serverData.append("fax_number", formData.get("fax_number") as string);
    const response = await submitLead(serverData);
    if (!response.success) {
      setSubmitStatus("error");
    } else {
      setSubmitStatus("success");
      (e.target as HTMLFormElement).reset();
    }
    setIsSubmitting(false);
  };

  return (
    <div className="min-h-screen bg-neutral-50 font-sans text-neutral-700">
      <nav className="flex justify-between items-center px-8 py-10 max-w-7xl mx-auto">
        <div className="flex items-center">
          <span className="text-2xl font-bold tracking-tight text-neutral-900">
            BROWNSTONE AI
          </span>
        </div>
        <div className="hidden md:flex space-x-8 text-xs font-bold uppercase tracking-[0.3em] text-neutral-500">
          <a href="#solutions" className="hover:text-neutral-900 transition">
            Solutions
          </a>
          <a
            href="#infrastructure"
            className="hover:text-neutral-900 transition"
          >
            Infrastructure
          </a>
          <a
            href="#audit"
            className="hover:text-neutral-900 transition border-b-2 border-neutral-900 pb-1"
          >
            Request Audit
          </a>
        </div>
      </nav>

      <section className="max-w-7xl mx-auto px-8 py-20 grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <h1 className="text-7xl font-bold leading-tight text-neutral-900 mb-8 tracking-tighter">
            Secure the{" "}
            <span className="text-amber-700 font-light italic">Perimeter.</span>
            <br />
            Scale the Vision.
          </h1>
          <p className="text-xl text-gray-600 mb-10 max-w-lg leading-relaxed">
            Infrastructure built for the Zero-Trust era. We isolate your
            proprietary AI in private vaults, keeping your data invisible to the
            public web.
          </p>
          <button className="bg-neutral-900 text-white px-10 py-5 rounded-sm font-bold hover:bg-neutral-700 transition uppercase tracking-widest text-sm">
            Explore the Vault
          </button>
        </div>

        <div className="bg-white p-6 rounded-lg shadow-2xl border border-gray-100 flex flex-col min-h-[450px]">
          <div className="flex items-center justify-between mb-4 border-b pb-4">
            <div className="flex gap-2">
              <div className="w-3 h-3 rounded-full bg-red-400"></div>
              <div className="w-3 h-3 rounded-full bg-green-400"></div>
            </div>
            <span className="text-[10px] font-mono text-gray-400 uppercase tracking-[0.2em]">
              node-alpha.brownstone.local
            </span>
          </div>
          <div className="flex-grow space-y-4 mb-4 overflow-y-auto max-h-[250px] pr-2 text-left">
            {messages.map((msg, i) => (
              <div
                key={i}
                className={`p-4 rounded-sm text-sm ${msg.role === "user" ? "bg-gray-100 ml-12 text-neutral-900" : "bg-neutral-800 text-white mr-12"}`}
              >
                {msg.content}
              </div>
            ))}
            {isTyping && (
              <div className="text-[10px] text-amber-700 animate-pulse uppercase tracking-widest">
                Encrypting...
              </div>
            )}
          </div>
          <form onSubmit={handleChat} className="mt-auto relative">
            <input
              type="text"
              value={chatInput}
              onChange={(e) => setChatInput(e.target.value)}
              placeholder="Query the infrastructure..."
              className="w-full p-4 bg-gray-50 border border-gray-200 rounded-sm focus:outline-none focus:border-amber-700 text-sm"
            />
            <button
              type="submit"
              className="absolute right-4 top-4 text-amber-700 font-bold text-xs uppercase tracking-widest"
            >
              Execute
            </button>
          </form>
        </div>
      </section>

      <section id="solutions" className="max-w-7xl mx-auto px-8 py-24">
        <div className="text-center mb-20">
          <h2 className="text-sm font-bold uppercase tracking-[0.3em] text-amber-700 mb-4">
            Your Strategic Advantage
          </h2>
          <p className="text-5xl font-bold text-neutral-700 tracking-tighter">
            Infrastructure built for your{" "}
            <span className="text-neutral-900 italic">Unfair Advantage.</span>
          </p>
        </div>
        <div className="grid md:grid-cols-2 lg:grid-cols-3 gap-10 text-left">
          <div className="group p-8 border border-gray-100 hover:border-amber-700 transition-all duration-500 bg-white shadow-sm hover:shadow-xl">
            <div className="w-12 h-12 bg-neutral-800 text-white flex items-center justify-center mb-6 group-hover:bg-amber-700 transition-colors">
              <svg
                fill="none"
                viewBox="0 0 24 24"
                strokeWidth={1.5}
                stroke="currentColor"
                className="w-6 h-6"
              >
                <path
                  strokeLinecap="round"
                  strokeLinejoin="round"
                  d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6.119c0 3.891 2.141 7.29 5.39 9.044a11.952 11.952 0 005.42 1.701c.142 0 .283-.002.423-.005a11.962 11.962 0 005.39-9.04c0-2.14-.56-4.15-1.543-5.881A11.947 11.947 0 0012 2.714z"
                />
              </svg>
            </div>
            <h3 className="text-xl font-bold text-neutral-900 mb-4 uppercase tracking-wider">
              The Sovereign Vault
            </h3>
            <p className="text-gray-600 text-sm leading-relaxed mb-6">
              Eliminate the liability of traditional VPNs. We deploy ZTNA and
              Managed XDR to turn your network into a ghost.
            </p>
            <ul className="text-xs font-bold text-amber-700 space-y-2 uppercase tracking-widest">
              <li>+ Zero Trust Access</li>
              <li>+ Compliance Management</li>
            </ul>
          </div>
          <div className="group p-8 border border-gray-100 hover:border-amber-700 transition-all duration-500 bg-white shadow-sm hover:shadow-xl">
            <div className="w-12 h-12 bg-neutral-800 text-white flex items-center justify-center mb-6 group-hover:bg-amber-700 transition-colors">
              <svg
                fill="none"
                viewBox="0 0 24 24"
                strokeWidth={1.5}
                stroke="currentColor"
                className="w-6 h-6"
              >
                <path
                  strokeLinecap="round"
                  strokeLinejoin="round"
                  d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"
                />
              </svg>
            </div>
            <h3 className="text-xl font-bold text-neutral-900 mb-4 uppercase tracking-wider">
              Autonomous Ops
            </h3>
            <p className="text-gray-600 text-sm leading-relaxed mb-6">
              Stop paying for "break-fix" cycles. Our Self-Healing IT uses AI to
              repair common issues before they hit the ticket queue.
            </p>
            <ul className="text-xs font-bold text-amber-700 space-y-2 uppercase tracking-widest">
              <li>+ AI Tier 1 Help Desk</li>
              <li>+ Predictive RMM</li>
            </ul>
          </div>
          <div className="group p-8 border border-gray-100 hover:border-amber-700 transition-all duration-500 bg-white shadow-sm hover:shadow-xl">
            <div className="w-12 h-12 bg-neutral-800 text-white flex items-center justify-center mb-6 group-hover:bg-amber-700 transition-colors">
              <svg
                fill="none"
                viewBox="0 0 24 24"
                strokeWidth={1.5}
                stroke="currentColor"
                className="w-6 h-6"
              >
                <path
                  strokeLinecap="round"
                  strokeLinejoin="round"
                  d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0v16.5m0-16.5L12 3m0 0l8.25 3m-8.25-3v13.5m-8.25 1.5L12 18.75m0 0l8.25-3m-8.25 3V6.75"
                />
              </svg>
            </div>
            <h3 className="text-xl font-bold text-neutral-900 mb-4 uppercase tracking-wider">
              Fractional CIO & AI Strategy
            </h3>
            <p className="text-gray-600 text-sm leading-relaxed mb-6">
              Technology is a line item; strategy is a multiplier. Our
              Fractional CIO & AI Strategy services align your infrastructure
              with your growth roadmap.
            </p>
            <ul className="text-xs font-bold text-amber-700 space-y-2 uppercase tracking-widest">
              <li>+ Digital Transformation</li>
              <li>+ Budget Roadmapping</li>
            </ul>
          </div>
        </div>
      </section>

      <section id="infrastructure" className="bg-neutral-800 py-24 text-white">
        <div className="max-w-7xl mx-auto px-8 grid md:grid-cols-2 gap-20 items-center">
          <div className="text-left">
            <h2 className="text-4xl font-bold mb-6 italic tracking-tight">
              The Ghost Network
            </h2>
            <p className="text-gray-400 leading-relaxed mb-8">
              Under an **Option B Architecture**, we strip away public IP
              addresses. Your data exists in a logically isolated environment,
              unreachable from the public internet.
            </p>
          </div>
          <div className="grid grid-cols-2 gap-4">
            <div className="p-8 border border-gray-700 bg-black/20 text-left">
              <span className="block text-3xl font-bold text-amber-700 mb-2">
                0.0ms
              </span>
              <span className="text-[10px] uppercase tracking-[0.3em] text-gray-500 font-bold">
                Public Exposure
              </span>
            </div>
            <div className="p-8 border border-gray-700 bg-black/20 text-left">
              <span className="block text-3xl font-bold text-amber-700 mb-2">
                100%
              </span>
              <span className="text-[10px] uppercase tracking-[0.3em] text-gray-500 font-bold">
                Data Sovereignty
              </span>
            </div>
          </div>
        </div>
      </section>

      <section className="bg-neutral-50 border-t border-b border-gray-100">
        {/* <EnterpriseServicesModule /> */}
      </section>

      <section id="audit" className="py-24 bg-white border-t border-gray-100">
        <div className="max-w-3xl mx-auto px-8 text-center">
          <h2 className="text-4xl font-bold text-neutral-900 mb-4 tracking-tighter uppercase">
            Request a Service Assessment
          </h2>
          <p className="text-gray-500 mb-12 text-base leading-relaxed">
            Infrastructure audit, AI readiness review, or security assessment —
            tell us what you need and a Fractional CIO will be in touch within
            one business day.
          </p>

          {submitStatus === "success" ? (
            <div className="border border-amber-700 bg-amber-50 p-10 text-left">
              <p className="text-[10px] font-bold uppercase tracking-[0.3em] text-amber-700 mb-2">
                Transmission Confirmed
              </p>
              <p className="text-xl font-bold text-neutral-900 mb-2">
                Request Received.
              </p>
              <p className="text-gray-500 text-sm">
                Our Fractional CIO team will review your request and respond
                within one business day.
              </p>
            </div>
          ) : (
            <form onSubmit={handleAuditRequest} className="text-left space-y-4">
              <input
                type="text"
                name="fax_number"
                className="hidden"
                tabIndex={-1}
                autoComplete="off"
              />
              <div className="grid md:grid-cols-2 gap-4">
                <div>
                  <label className="block text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 mb-2">
                    Full Name
                  </label>
                  <input
                    name="auditName"
                    type="text"
                    placeholder="Jane Smith"
                    className="w-full p-4 border border-gray-200 focus:border-amber-700 outline-none text-sm bg-gray-50"
                  />
                </div>
                <div>
                  <label className="block text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 mb-2">
                    Corporate Email <span className="text-amber-700">*</span>
                  </label>
                  <input
                    name="auditEmail"
                    type="email"
                    placeholder="jane@company.com"
                    required
                    className="w-full p-4 border border-gray-200 focus:border-amber-700 outline-none text-sm bg-gray-50"
                  />
                </div>
              </div>

              <div>
                <label className="block text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 mb-2">
                  Service of Interest <span className="text-amber-700">*</span>
                </label>
                <select
                  name="serviceInterest"
                  required
                  className="w-full p-4 border border-gray-200 focus:border-amber-700 outline-none text-sm bg-gray-50 text-neutral-700"
                >
                  <option value="">Select a service...</option>
                  <option value="ai_audit">AI Security Audit</option>
                  <option value="ai_readiness">AI Readiness Assessment</option>
                  <option value="infrastructure_audit">
                    Infrastructure Audit
                  </option>
                  <option value="msp">MSP Services</option>
                  <option value="capstone">Capstone Program</option>
                  <option value="general">General Inquiry</option>
                </select>
              </div>

              <div className="grid md:grid-cols-2 gap-4">
                <div>
                  <label className="block text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 mb-2">
                    Requested Call Date{" "}
                    <span className="lowercase font-normal tracking-normal">
                      (Optional)
                    </span>
                  </label>
                  <input
                    name="auditDate"
                    type="date"
                    className="w-full p-4 border border-gray-200 focus:border-amber-700 outline-none text-sm bg-gray-50 text-neutral-700"
                  />
                </div>
                <div>
                  <label className="block text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 mb-2">
                    Requested Time{" "}
                    <span className="lowercase font-normal tracking-normal">
                      (Optional)
                    </span>
                  </label>
                  <input
                    name="auditTime"
                    type="time"
                    className="w-full p-4 border border-gray-200 focus:border-amber-700 outline-none text-sm bg-gray-50 text-neutral-700"
                  />
                </div>
              </div>

              <div>
                <label className="block text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400 mb-2">
                  Your Message
                </label>
                <textarea
                  name="auditMessage"
                  placeholder="Tell us about your infrastructure or scheduling preferences..."
                  rows={4}
                  className="w-full p-4 border border-gray-200 focus:border-amber-700 outline-none text-sm bg-gray-50 resize-none text-neutral-700"
                ></textarea>
              </div>

              {submitStatus === "error" && (
                <p className="text-red-500 text-xs font-bold uppercase tracking-widest">
                  ⚠ Transmission failed. Please try again or email us directly.
                </p>
              )}

              <button
                type="submit"
                disabled={isSubmitting}
                className={`w-full md:w-auto bg-neutral-900 text-white px-12 py-5 font-bold uppercase tracking-widest text-sm transition ${isSubmitting ? "opacity-50 cursor-not-allowed" : "hover:bg-neutral-700"}`}
              >
                {isSubmitting ? "Transmitting..." : "Submit Request →"}
              </button>
            </form>
          )}
        </div>
      </section>

      <footer className="py-12 bg-gray-50 border-t border-gray-100 text-center">
        <p className="text-[10px] text-gray-400 uppercase tracking-[0.5em] font-bold">
          © 2026 Brownstone AI & Infrastructure LLC. All Rights Reserved.
        </p>
      </footer>
    </div>
  );
}
